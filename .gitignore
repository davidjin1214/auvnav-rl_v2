# Paper figures (override above) — these are paper deliverables, not run outputs.
# `figures/` above matches at every level, and git will not descend into an
# excluded directory, so each negation must name the directory itself before
# its contents.
!paper/archive/rebrac_standalone/figures/
!paper/archive/rebrac_standalone/figures/**
!paper/thesis_ch5/figures/
!paper/thesis_ch5/figures/**

# LaTeX build artifacts (re-ignore inside paper/, all levels)
paper/**/*.aux
paper/**/*.bbl
paper/**/*.blg
paper/**/*.log
paper/**/*.out
paper/**/*.toc
paper/**/*.fls
paper/**/*.fdb_latexmk
paper/**/*.xdv
paper/**/*.synctex.gz

# Python bytecode caches inside paper figure scripts
paper/**/__pycache__/
paper/**/*.pyc
texput.log
paper/archive/rebrac_standalone/figures/**/.DS_Store

